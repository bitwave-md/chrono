CHRONO_VERSION=latest
CHRONO_RELEASE_REPOSITORY=bitwave-md/chrono
CHRONO_GITHUB_TOKEN=
CHRONO_STATUS_DIR=./data/status
CHRONO_APP_IMAGE=ghcr.io/bitwave-md/chrono
CHRONO_MIGRATOR_IMAGE=ghcr.io/bitwave-md/chrono-migrator
CHRONO_UPDATER_IMAGE=ghcr.io/bitwave-md/chrono-updater
CHRONO_APP_REF=
CHRONO_MIGRATOR_REF=
CHRONO_UPDATER_REF=
CHRONO_BUILD_CONTEXT=.
CHRONO_INSTALL_MODE=source
CHRONO_INSTALL_DIR=
CHRONO_UPDATE_REQUEST_DIR=./data/update-requests
CHRONO_DOCKER_GID=0
CHRONO_BIND_ADDRESS=127.0.0.1
CHRONO_PORT=3000
COMPOSE_PROFILES=
CHRONO_DOMAIN=
MINIO_ROOT_USER=chrono-root
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-root-password
S3_ENDPOINT=http://storage:9000
S3_REGION=us-east-1
S3_BUCKET=chrono
S3_ACCESS_KEY=chrono-app
S3_SECRET_KEY=replace-with-a-random-storage-application-password
S3_FORCE_PATH_STYLE=true
STORAGE_WORKSPACE_QUOTA_GB=10
STORAGE_PERSONAL_QUOTA_MB=100
POSTGRES_DB=chrono
POSTGRES_USER=chrono
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://chrono:replace-with-a-random-database-password@localhost:5432/chrono
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
AUTH_SETUP_TOKEN=replace-with-a-random-64-character-setup-code
AUTH_SETUP_WORKSPACE_NAME=Bitwave
AUTH_SETUP_WORKSPACE_SLUG=bitwave
