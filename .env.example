CHRONO_VERSION=latest
CHRONO_APP_IMAGE=ghcr.io/bitwave-md/chrono
CHRONO_MIGRATOR_IMAGE=ghcr.io/bitwave-md/chrono-migrator
CHRONO_BUILD_CONTEXT=.
CHRONO_BIND_ADDRESS=127.0.0.1
CHRONO_PORT=3000
COMPOSE_PROFILES=
CHRONO_DOMAIN=
POSTGRES_DB=chrono
POSTGRES_USER=chrono
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://chrono:replace-with-a-random-database-password@localhost:5432/chrono
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
EMAIL_SERVER=
EMAIL_FROM="Chrono <chrono@localhost>"
AUTH_BOOTSTRAP_EMAIL=owner@example.com
AUTH_BOOTSTRAP_TOKEN=replace-with-a-random-32-character-or-longer-setup-key
AUTH_BOOTSTRAP_WORKSPACE_NAME=Bitwave
AUTH_BOOTSTRAP_WORKSPACE_SLUG=bitwave
