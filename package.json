{
  "name": "chrono",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "stack:up": "docker compose -f compose.yaml -f compose.build.yaml -f compose.dev.yaml up --build -d",
    "stack:down": "docker compose -f compose.yaml -f compose.build.yaml -f compose.dev.yaml down",
    "lint": "eslint",
    "test": "node --import tsx --test src/db/demo-fixtures.test.ts src/db/postgres-error.test.ts src/modules/auth/domain/bootstrap-credentials.test.ts src/modules/auth/domain/email-address.test.ts src/modules/auth/infrastructure/email-server-configuration.test.ts src/modules/clients/domain/client-icon.test.ts src/modules/inbox/domain/notification-recipients.test.ts src/modules/workspaces/domain/workspace-slug.test.ts src/modules/shared/domain/uppercase-code.test.ts src/modules/settings/infrastructure/github-release-client.test.ts src/modules/storage/domain/share-token.test.ts src/modules/storage/domain/upload-policy.test.ts src/modules/time-tracking/domain/time-category-key.test.ts src/modules/time-tracking/application/time-entry-validator.test.ts src/modules/workspace-ui/domain/client-time-report.test.ts src/modules/workspace-ui/domain/favorite-target.test.ts src/modules/workspace-ui/domain/issue-list-groups.test.ts src/modules/workspace-ui/domain/issue-route.test.ts src/modules/workspace-ui/domain/issue-time-summary.test.ts src/modules/workspace-ui/domain/manual-time-entry-date.test.ts src/modules/workspace-ui/domain/project-list-groups.test.ts src/modules/workspace-ui/state/workspace-view-store.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:demo": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1092.0",
    "@gsap/react": "2.1.2",
    "@radix-ui/react-avatar": "1.2.2",
    "@radix-ui/react-collapsible": "1.1.16",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-scroll-area": "1.2.14",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-separator": "1.1.11",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-toggle-group": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.12",
    "@tanstack/react-query": "5.101.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "file-type": "^22.0.1",
    "gsap": "3.15.0",
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "next-auth": "4.24.14",
    "next-themes": "^0.4.6",
    "nodemailer": "7.0.13",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-hot-toast": "^2.6.0",
    "recharts": "3.8.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next-auth": {
      "uuid": "11.1.1"
    }
  }
}
